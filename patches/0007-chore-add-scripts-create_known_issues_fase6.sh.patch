+++        H[("HMAC-SHA256 Cryptographic Ledger (Immutable)")]
+++    end
+++
+++    %% Data Flow
+++    V --> B
+++    B --> LS
+++    LS -- "Valid Tasks" --> C
+++    C -- "Massive Outputs" --> S
+++    S -- "Truncated Safe Context" --> E1
+++    E1 & E2 --> F
+++    F -- "If Doubt < 40%" --> I
