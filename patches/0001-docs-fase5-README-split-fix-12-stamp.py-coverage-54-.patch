+    key2 = isolated_stamp._derive_hmac_key_from_password("hunter2", salt)
+    key3 = isolated_stamp._derive_hmac_key_from_password("different", salt)
+    assert key1 == key2
+    assert key1 != key3
+    assert len(key1) == isolated_stamp.HMAC_KEY_LENGTH_BYTES
+
